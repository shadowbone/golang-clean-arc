STACK_NAME=golang-rest-api-staging
IMAGE=ghcr.io/shadowbone/golang-clean-arc
IMAGE_TAG=staging
APP_IP=172.30.0.40

APP_ENV=production
SHUTDOWN_TIMEOUT=20s
TRUSTED_PROXIES=172.30.0.1

POSTGRES_DB=db_golang
POSTGRES_USER=appuser
POSTGRES_PASSWORD=
DB_SSL=disable
ALLOW_INSECURE_DB=true
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_TRACE_QUERY=false
PG_SHM_SIZE=128mb

JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=360h
BCRYPT_COST=12

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m

LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUEST_BODY=false