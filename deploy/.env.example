# Identitas stack
STACK_NAME=golang-rest-api-staging
IMAGE=ghcr.io/shadowbone/golang-clean-arc
IMAGE_TAG=staging

# App
APP_ENV=production
SHUTDOWN_TIMEOUT=20s

# Database
POSTGRES_DB=db_golang
POSTGRES_USER=appuser
POSTGRES_PASSWORD=
DB_SSL=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_TRACE_QUERY=false
PG_SHM_SIZE=256mb

# Auth
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=360h
BCRYPT_COST=12

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUEST_BODY=false