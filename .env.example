# App
APP_PORT=3000
APP_ENV=development
SHUTDOWN_TIMEOUT=20s

# Database
POSTGRES_DB=db_golang
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_APP_NAME=api
DB_TRACE_QUERY=false

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_REQUEST_BODY=false

## Auth
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=360h
BCRYPT_COST=12

## Redis
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

## Rate Limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=1h