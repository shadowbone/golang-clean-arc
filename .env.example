# App
APP_PORT=3000
APP_ENV=development
SHUTDOWN_TIMEOUT=20s

# Database
POSTGRES_DB=db_golang
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=disable
DB_MAX_CONNS=10
